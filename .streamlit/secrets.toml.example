# Real Google sign-in for the dashboard (Streamlit native OIDC).
# Copy this file to `.streamlit/secrets.toml` (git-ignored) and fill in your
# Google OAuth client. Once present, a "Continue with Google" button appears and
# real accounts persist across sessions (remembered via a secure cookie).
#
# SETUP (5 min):
#   1. https://console.cloud.google.com  ->  APIs & Services  ->  Credentials
#   2. Create OAuth client ID  ->  type: Web application
#   3. Authorized redirect URI:  http://localhost:8501/oauth2callback
#      (for the deployed app add its URL too, e.g. https://apollo-m.streamlit.app/oauth2callback)
#   4. Copy the Client ID + Client Secret below.
#   5. pip install Authlib   (already installed)

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "CHANGE_ME_to_a_long_random_string"

[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
