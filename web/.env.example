# Supabase project settings → API
# Safe to expose: the anon key is constrained by your row-level security policies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only. Bypasses RLS — used solely by scripts/seed.mjs.
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
